# Rate limiting (slowapi), формат "<count>/<period>".
# Хранилище счётчиков — in-memory на процесс (per-worker). Текущий деплой — 1
# uvicorn-воркер, поэтому этого достаточно; горизонтальное масштабирование
# (--workers>1) требует общего стора (Redis).
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REFRESH=10/minute
RATE_LIMIT_ANSWER=20/minute
